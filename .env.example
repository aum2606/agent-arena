OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: password for the local Postgres container (compose has a local-only default)
POSTGRES_PASSWORD=
# A public deployment: the password of the limited database role the API and the worker use (D-079);
# POSTGRES_PASSWORD is then only the owner's, used by the one-shot migration.
APP_DB_PASSWORD=

# Local runs outside Docker (compose sets these for its own containers)
DATABASE_URL=
REDIS_URL=
FIGHTERS_CONFIG=

# GitHub OAuth app for sign-in (callback URL: http://127.0.0.1:3100/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set to 0 to turn off the local sign-in-as-anyone form in the compose stack
ARENA_DEV_LOGIN=

# Encrypts users' API keys in the database. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it: without it the saved keys cannot be read again.
KEY_ENCRYPTION_SECRET=
# While rotating that secret: the one being retired (comma-separated if several). Then run
#   uv run python -m arena_api.rotate_keys
# and remove it. See docs/SELF_HOSTING.md.
KEY_ENCRYPTION_OLD_SECRETS=

# Where the worker runs model-written code: gvisor (default; needs Docker with the runsc runtime) or off
# (local development only: the code then runs on your machine, unsandboxed).
ARENA_SANDBOX=

# Behind a reverse proxy: the name of a header the proxy OVERWRITES with the visitor's address (for example
# X-Real-IP). The per-address limits for visitors use it; unset, every visitor shares the web server's address
# (fine for one person on localhost, wrong for a public site). Never name a header the proxy passes through.
CLIENT_IP_HEADER=

# How many database connections the API and the worker keep at most (default 10 each).
ARENA_DB_POOL=

# A public deployment (docs/SELF_HOSTING.md): docker-compose.prod.yml needs all of these.
# Letters and digits only for the two passwords (they go into connection URLs).
REDIS_PASSWORD=
# Your public https:// address, no trailing slash
PUBLIC_URL=

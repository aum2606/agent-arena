OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: password for the local Postgres container (compose has a local-only default)
POSTGRES_PASSWORD=

# Local runs outside Docker (compose sets these for its own containers)
DATABASE_URL=
REDIS_URL=
FIGHTERS_CONFIG=

# GitHub OAuth app for sign-in (callback URL: http://127.0.0.1:3100/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set to 0 to turn off the local sign-in-as-anyone form in the compose stack
ARENA_DEV_LOGIN=

# Encrypts users' API keys in the database. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it: without it the saved keys cannot be read again.
KEY_ENCRYPTION_SECRET=
